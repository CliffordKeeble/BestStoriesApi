<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CA1050: BenchmarkDotNet names its reports after the type's full name, so the benchmark types stay out
         of a namespace and a rerun writes the same report names as the ones kept in bench/results. -->
    <NoWarn>$(NoWarn);CA1050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BestStoriesApi\BestStoriesApi.csproj" />
  </ItemGroup>

</Project>
